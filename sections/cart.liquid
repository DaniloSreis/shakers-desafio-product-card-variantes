{{ "product-card.css" | asset_url | stylesheet_tag }}
<script src="{{'product-card.js' |  asset_url}}" defer></script>

{% assign clothes_variants = section.settings.product_id.variants %}
<header class="header container">
  <h1 class="header__logo">Street Lab</h1>
  <nav class="header__nav">
    <ul class="header__list">
      <li class="header__item">
        <a href="./" class="header__link">Produtos</a>
      </li>
      <li class="header__item">
        <a href="" class="header__link">Conta</a>
      </li>
      <li class="header__item header__button-cart">
        <img
          src="{{'black-shopping-bag.svg' |  asset_url }}"
          alt=""
          width="auto"
          height="auto">
      </li>
    </ul>
    <div class="header__cart-overlay"></div>
    <div class="header__cart">
      <div class="header__close-button"><img
          src="{{'close.svg'|  asset_url}}"
          alt=""
          width="auto"
          height="auto"></div>
    </div>
  </nav>
</header>
<div class="container">
  <section class="product-card" data-variants='{{clothes_variants | json}}'>
    <img
      src=""
      alt=""
      class="product-card__image"
      width="auto"
      height="auto">
    <form class="product-card__informations">
      <h2 class="product-card__title">{{ section.settings.product_id.title }}</h2>
      <p class="product-card__description">{{ section.settings.product_id.description | strip_html }}</p>
      <span class="product-card__price"></span>

      <span class="product-card__label">Cor</span>
      <ul class="product-card__colors">
        <li class="product-card__color product-card__color--selected">Preto</li>
        <li class="product-card__color">Branco</li>
      </ul>
      <span class="product-card__label">Tamanho</span>
      <ul class="product-card__sizes">
        <li class="product-card__size product-card__size--selected">P</li>
        <li class="product-card__size">M</li>
        <li class="product-card__size">G</li>
      </ul>
      <div class="product-card__button">
        Adicionar a sacola
        <img
          src="{{'white-shopping-bag.svg' |  asset_url}}"
          width="auto"
          height="auto"
          class="product-card__button-img">
      </div>
    </form>
  </section>
</div>

{% schema %}
  {
    "name": "Product Card",
    "settings": [
      {
        "type": "product",
        "id": "product_id",
        "label": "Produto"
      }
    ],
    "presets": [
      {
        "name": "Product Card"
      }
    ]
  }
{% endschema %}